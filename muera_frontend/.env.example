# ── Supabase (same project as the admin) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # a.k.a. publishable key
SUPABASE_SERVICE_ROLE_KEY=                # server only — checkout, webhooks, contact form

# ── Stripe ───────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from the webhook endpoint /api/stripe/webhook

# ── MirrorSize 3D configurator ───────────────────────────────────
MIRRORSIZE_MERCHANT_ID=                   # MirrorSize account email
MIRRORSIZE_API_KEY=                       # MirrorSize dashboard → developer help
